# Токен бота из Discord Developer Portal → Bot → Reset Token.
DISCORD_BOT_TOKEN=

# ID сервера (ПКМ по серверу → Copy Server ID, нужен Developer Mode) и роли
# для верифицированных (привязавших Discord) участников.
GUILD_ID=
VERIFIED_ROLE_ID=

# Ссылка, которую бот присылает по /link. Должна вести на уже существующий
# эндпоинт сайта (public/api.php): GET /api/auth/discord/link
LINK_URL=https://www.boberland.ru/api/auth/discord/link

# Как часто (сек) сверять discord_id из БД с ролями на сервере.
# 3600 = раз в час. Тем же тиком синхронизируются роли из ROLE_MAPPING_FILE.
SYNC_INTERVAL_SECONDS=3600

# Путь к JSON-файлу с маппингом «роль/VIP-группа на сайте → ID роли в Discord».
# См. role_mapping.example.json — скопируйте его в role_mapping.json и впишите
# свои ID ролей. Ключи "admin_groups" должны совпадать с названиями Админ-групп
# (Админ-панель → Настройки → Админ-группы — AdminSystem для CS2, например
# «Главный администратор»), а ключи "vip_groups" — с group_key VIP-группы
# (Админ-панель → Настройки → VIP-группы, «Название группы из groups.ini»).
# Значением может быть один ID роли или список ID в квадратных скобках, если
# группе нужно выдать сразу несколько ролей в Discord: "Главный администратор":
# ["111...", "222..."]. Файл перечитывается на каждом тике — перезапуск бота
# при правке не нужен.
ROLE_MAPPING_FILE=role_mapping.json

# Та же MySQL база, что и у сайта (см. корневой .env.example). Боту хватает
# SELECT по таблицам users, as_admins, as_admins_servers, as_groups, vip_users —
# рекомендуется завести отдельного read-only пользователя MySQL вместо
# DB_USER/DB_PASS сайта, например:
#   GRANT SELECT ON <DB_NAME>.users TO 'bot_ro'@'%';
#   GRANT SELECT ON <DB_NAME>.as_admins TO 'bot_ro'@'%';
#   GRANT SELECT ON <DB_NAME>.as_admins_servers TO 'bot_ro'@'%';
#   GRANT SELECT ON <DB_NAME>.as_groups TO 'bot_ro'@'%';
#   GRANT SELECT ON <DB_NAME>.vip_users TO 'bot_ro'@'%';
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ── Релей OAuth-обмена для сайта ────────────────────────────────────────────
# IP сервера сайта не пускает discord.com (см. diag_network.php в корне
# проекта), поэтому обмен кода на токен идёт через HTTP-эндпоинт этого бота
# вместо прямого запроса с сайта. Те же значения, что и в DISCORD_CLIENT_ID/
# DISCORD_CLIENT_SECRET сайта (OAuth2 → General в Developer Portal).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Общий секрет с DISCORD_RELAY_SECRET в .env сайта — без него релей отвечает
# 401 кому угодно. Сгенерировать: openssl rand -hex 32
RELAY_SECRET=

# Порт, на котором бот поднимает HTTP-эндпоинт /discord-exchange. Публичный
# адрес (для DISCORD_RELAY_URL в .env сайта) смотрите в панели bothost.ru —
# там же может быть свой обязательный PORT, тогда впишите его сюда.
PORT=8080

# ── Лог действий админ-панели ───────────────────────────────────────────────
# ID текстового канала (ПКМ по каналу → Copy Channel ID), куда бот будет
# дублировать всё, что делают в веб-админке (Services\AdminLog на сайте):
# кто из админов что сделал, кому и что изменил. Не задан = /admin-log
# отвечает 503, сайт при этом работает как обычно — просто без Discord-лога.
ADMIN_LOG_CHANNEL_ID=

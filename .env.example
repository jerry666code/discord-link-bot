# Токен бота из Discord Developer Portal → Bot → Reset Token.
DISCORD_BOT_TOKEN=

# ID сервера (ПКМ по серверу → Copy Server ID, нужен Developer Mode) и роли
# для верифицированных (привязавших Discord) участников.
GUILD_ID=
VERIFIED_ROLE_ID=

# Ссылка, которую бот присылает по /link. Должна вести на уже существующий
# эндпоинт сайта (public/api.php): GET /api/auth/discord/link
LINK_URL=https://www.boberland.ru/api/auth/discord/link

# Как часто (сек) сверять discord_id из БД с ролями на сервере.
SYNC_INTERVAL_SECONDS=60

# Та же MySQL база, что и у сайта (см. корневой .env.example). Боту хватает
# SELECT по таблице users — рекомендуется завести отдельного read-only
# пользователя MySQL вместо DB_USER/DB_PASS сайта.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ── Релей OAuth-обмена для сайта ────────────────────────────────────────────
# IP сервера сайта не пускает discord.com (см. diag_network.php в корне
# проекта), поэтому обмен кода на токен идёт через HTTP-эндпоинт этого бота
# вместо прямого запроса с сайта. Те же значения, что и в DISCORD_CLIENT_ID/
# DISCORD_CLIENT_SECRET сайта (OAuth2 → General в Developer Portal).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Общий секрет с DISCORD_RELAY_SECRET в .env сайта — без него релей отвечает
# 401 кому угодно. Сгенерировать: openssl rand -hex 32
RELAY_SECRET=

# Порт, на котором бот поднимает HTTP-эндпоинт /discord-exchange. Публичный
# адрес (для DISCORD_RELAY_URL в .env сайта) смотрите в панели bothost.ru —
# там же может быть свой обязательный PORT, тогда впишите его сюда.
PORT=8080
